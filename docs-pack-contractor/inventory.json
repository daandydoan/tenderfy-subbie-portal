 "glossary": [
  {
   "term": "Main contractor",
   "meaning": "The head contractor using this portal to source and award subcontractor work."
  },
  {
   "term": "Subcontractor (subbie)",
   "meaning": "A trade business the contractor invites to quote."
  },
  {
   "term": "Tender",
   "meaning": "A project the contractor is bidding on or delivering, broken into tasks for subbies."
  },
  {
   "term": "Quote request",
   "meaning": "A task sent to one or more subbies asking them to price it."
  },
  {
   "term": "Compare",
   "meaning": "Viewing subbie quotes side by side to pick one."
  },
  {
   "term": "Award",
   "meaning": "Accepting a subbie's quote; the subbie wins the work."
  },
  {
   "term": "Nudge",
   "meaning": "A reminder sent to an awaiting subbie, capped per request."
  },
  {
   "term": "Supply chain",
   "meaning": "The contractor's directory of subcontractors."
  },
  {
   "term": "Build Tender",
   "meaning": "Assembling the tender document pack (pages, attachments)."
  }
 ],
